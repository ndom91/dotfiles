[
  {
    "plugin_id": "herdr-bar",
    "name": "Bar",
    "version": "0.1.0",
    "min_herdr_version": "0.7.4",
    "description": "Cmd+K command bar: fuzzy-jump to any tab or agent",
    "manifest_path": "/Users/ndom91/.config/herdr/plugins/github/herdr-bar-96eebe452a9c/herdr-plugin.toml",
    "plugin_root": "/Users/ndom91/.config/herdr/plugins/github/herdr-bar-96eebe452a9c",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "open",
        "title": "Open bar",
        "description": "Fuzzy-jump to any tab or agent",
        "contexts": [
          "global"
        ],
        "command": [
          "sh",
          "-c",
          "herdr_bin=\"${HERDR_BIN_PATH:-herdr}\"; [ -x \"$herdr_bin\" ] || herdr_bin=herdr; exec \"$herdr_bin\" plugin pane open --plugin herdr-bar --entrypoint bar --placement popup"
        ]
      }
    ],
    "panes": [
      {
        "id": "bar",
        "title": "Bar",
        "description": "Fuzzy-jump to any tab or agent",
        "placement": "popup",
        "width": "74%",
        "height": "62%",
        "command": [
          "python3",
          "run.py"
        ]
      }
    ],
